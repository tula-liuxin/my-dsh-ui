{
  "name": "my-dsh-ui",
  "version": "0.1.4",
  "private": false,
  "description": "DSH UI 子插件容器：把界面能力做成可开关、可组合、可卸载的子插件；内置「置顶会话」子插件。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "subplugins",
    "scripts/build.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check index.js && node --check client.js && node scripts/build.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "ui",
    "sub-plugin",
    "pinned"
  ],
  "license": "MIT",
  "author": {
    "name": "leo",
    "url": "https://github.com/tula-liuxin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tula-liuxin/my-dsh-ui.git"
  },
  "homepage": "https://github.com/tula-liuxin/my-dsh-ui#readme",
  "bugs": {
    "url": "https://github.com/tula-liuxin/my-dsh-ui/issues"
  }
}
